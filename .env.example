# Database
DATABASE_URL="postgresql://username:password@localhost:5432/re-astr"

# Session / cookie signing (no default — boot fails if missing)
COOKIE_SECRET="your-cookie-secret-key-here"

# Session Configuration (optional - has defaults)
AUTH_SESSION_EXPIRES="604800"  # 7 days in seconds
AUTH_SESSION_UPDATE_AGE="86400"  # 1 day in seconds

# Node Environment: development | production | test
NODE_ENV="development"

# Log level: All | Fatal | Error | Warn | Info | Debug | Trace | None (case-sensitive)
LOG_LEVEL="Debug"

# HTTP server port (optional - defaults to 3000)
PORT="3000"

# Object storage (Garage, S3-compatible) — dev keys below must match what
# scripts/garage-bootstrap.sh imports into the local Garage container.
STORAGE_ENDPOINT="http://localhost:3900"
STORAGE_REGION="garage"
STORAGE_ACCESS_KEY_ID="GKcd0d2fb5316b4e1ec0c3cad9"
STORAGE_SECRET_ACCESS_KEY="2c3eda22c008194a51b2db556c1ae290e8eaca9063554ebd4c95ff9d649be12d"
