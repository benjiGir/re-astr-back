{
  "name": "re-astr-server",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "check": "oxfmt && oxlint --fix",
    "check:ci": "oxfmt --check && oxlint",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/Seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@aws-sdk/s3-request-presigner": "^3.1089.0",
    "@effect/opentelemetry": "4.0.0-beta.97",
    "@effect/platform-node": "4.0.0-beta.97",
    "@effect/sql-pg": "4.0.0-beta.97",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "argon2": "0.44.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.97",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.97",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
